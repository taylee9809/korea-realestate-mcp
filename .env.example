# 공공데이터포털(data.go.kr)에서 "국토교통부_단독/다가구 매매 실거래가 자료" API 신청 후 발급받은 서비스키
MOLIT_SERVICE_KEY=

# open.law.go.kr 에서 발급받은 OC(사용자 이메일 아이디, @ 앞부분)
LAW_OC=

# business.juso.go.kr(도로명주소 안내시스템)에서 무료 발급받은 승인키(confmKey)
JUSO_API_KEY=

# developers.kakao.com에서 발급받은 REST API 키. 발급 후 앱 설정에서 "카카오맵" 제품을
# 별도로 활성화해야 동작함 — 안 켜면 category/address 검색이 403(OPEN_MAP_AND_LOCAL) 에러남
KAKAO_REST_API_KEY=

# vworld.kr에서 무료 발급받은 오픈API 인증키. 도메인 등록 필수(로컬 개발은 "localhost")
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
